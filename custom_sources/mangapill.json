{
  "id": "mangapill",
  "name": "Mangapill (Fast High-Quality Manga)",
  "base_url": "https://mangapill.com",
  "languages": ["en"],
  "is_nsfw": false,
  "tags": ["english", "manga", "fast", "scans"],
  "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
  "search": {
    "url_template": "{base_url}/search?q={query}",
    "method": "GET",
    "regex": {
      "item_pattern": "split:<figure class=\"w-full h-52",
      "id_regex": "href=\"/manga/([^\"\\s]+)\"",
      "cover_regex": "data-src=\"([^\"]+)\"",
      "title_regex": "(?s)class=\"[^\"]*font-black[^\"]*\">\\s*([^<]+)</div>",
      "genres_regex": "class=\"[^\"]*bg-card[^\"]*\">([^<]+)</div>",
      "year_regex": "bg-orange-500[^\"]*\">([0-9]+)</div>",
      "status_regex": "bg-green-500[^\"]*\">([^<]+)</div>"
    }
  },
  "chapters": {
    "url_template": "{base_url}/manga/{manga_id}",
    "method": "GET",
    "regex": {
      "pattern": "href=\"/chapters/([^\"]+)\"[^>]*>\\s*(?:Chapter\\s*)?([0-9.]+)\\s*</a>",
      "id_group": 1,
      "title_group": 2
    }
  },
  "pages": {
    "url_template": "{base_url}/chapters/{chapter_id}",
    "method": "GET",
    "regex": {
      "pattern": "<img [^>]*class=\"[^\"]*js-page[^\"]*\"[^>]*data-src=\"([^\"]+)\"|data-src=\"([^\"]+)\"[^>]*class=\"[^\"]*js-page[^\"]*\"",
      "id_group": 1
    }
  }
}
