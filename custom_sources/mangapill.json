{
  "id": "mangapill",
  "name": "MangaPill (English)",
  "base_url": "https://mangapill.com",
  "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
  "search": {
    "url_template": "{base_url}/quick-search?q={query}",
    "method": "GET",
    "regex": {
      "pattern": "(?s)<a href=\"/manga/([^\"]+)\"[^>]*>.*?<img [^>]*(?:src|data-src)=\"([^\"]+)\"[^>]*>.*?<div class=\"[^\"]*font-bold[^\"]*\">([^<]+)</div>",
      "id_group": 1,
      "cover_group": 2,
      "title_group": 3
    }
  },
  "chapters": {
    "url_template": "{base_url}/manga/{manga_id}",
    "method": "GET",
    "regex": {
      "pattern": "<a href=\"/chapters/([^\"]+)\"[^>]*>\\s*Chapter\\s+([0-9.]+)\\s*</a>",
      "id_group": 1,
      "title_group": 2
    }
  },
  "pages": {
    "url_template": "{base_url}/chapters/{chapter_id}",
    "method": "GET",
    "regex": {
      "pattern": "<img [^>]*data-src=\"([^\"]+)\"[^>]*class=\"[^\"]*js-page[^\"]*",
      "id_group": 1
    }
  }
}
